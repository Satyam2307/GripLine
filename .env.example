# GripLine Backend — Environment Variables
# Copy this file to .env and adjust as needed.

# Mock mode: bypass CLIP model, use deterministic demo data
GRIPLINE_MOCK=false

# Hugging Face model ID for zero-shot image classification
GRIPLINE_MODEL_ID=openai/clip-vit-base-patch32

# Maximum upload file size in megabytes
GRIPLINE_MAX_FILE_SIZE_MB=100

# Video analysis defaults
GRIPLINE_DEFAULT_FRAME_STRIDE=5
GRIPLINE_DEFAULT_MAX_FRAMES=30
